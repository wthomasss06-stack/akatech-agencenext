# Copier ce modèle vers .env.local puis remplacer les valeurs fictives.
# Utiliser uniquement une base Neon de développement dans l'environnement local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Resend — expéditeur vérifié en production et destinataire des alertes
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=you@example.com

# Assistant IA (les clés secondaires Gemini sont facultatives)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GROQ_API_KEY=replace-with-groq-api-key

# Authentification mono-admin du dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Vercel Cron : secret aléatoire long, requis pour protéger les reprises d'e-mails
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# HMAC d'IP par jour pour éviter les alertes visiteurs en double.
# À définir avec un secret dédié et stable; si vide, le code utilise RESEND_API_KEY.
VISITOR_ALERT_HASH_SECRET=replace-with-a-different-stable-random-secret

# URLs publiques utilisées par le site et les alertes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary — nécessaire uniquement pour les opérations d'upload d'images
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NODE_ENV est défini automatiquement par Next.js / l'hébergeur; ne pas le définir ici.
