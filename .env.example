# ── Resend (/api/contact, /api/assistant, alertes visiteurs) ──
# FROM_EMAIL : expéditeur vérifié en production (onboarding@resend.dev ne
# livre qu'à l'adresse du compte Resend). ADMIN_EMAIL : destinataire des alertes.
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=

# ── URL publique du site (liens dans les e-mails et le chatbot) ──
# Exemple : https://akatech.vercel.app — sans slash final.
NEXT_PUBLIC_SITE_URL=

# ── Alertes e-mail visiteurs / intention de devis (lib/email-notifications.js) ──
# CRON_SECRET : secret aléatoire long (ex. `openssl rand -hex 32`). Vercel
# l'envoie automatiquement au Cron /api/notifications/dispatch (reprise des
# e-mails en échec, toutes les 5 min). Sans lui, la route répond 401.
CRON_SECRET=
# Secret dédié et STABLE pour l'empreinte HMAC quotidienne de l'IP (anti-doublon
# d'alerte : 1 alerte par IP et par jour UTC ; l'IP brute n'est jamais stockée
# ni envoyée). Si vide, RESEND_API_KEY sert de repli — le changer (ou changer la
# clé Resend) peut produire une alerte en double le jour même.
VISITOR_ALERT_HASH_SECRET=

# ── Assistant IA (/api/assistant) ──
# Clé API Gemini (gratuite) — à générer sur https://aistudio.google.com/app/apikey
# Important : ne PAS activer la facturation sur ce projet Google si tu veux
# rester sur le palier gratuit (l'activer bascule tout en payant).
GEMINI_API_KEY=

# Facultatif : jusqu'à 3 clés Gemini de secours (autres comptes Google),
# essayées dans l'ordre si la précédente est épuisée/invalide (cascade
# gérée par lib/ai-providers.js). Laisse vide si tu n'en as qu'une.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Secours si Gemini est indisponible/quota épuisé — clé gratuite sur
# https://console.groq.com/keys
GROQ_API_KEY=

# ── Cloudinary (images servies depuis le CDN plutôt que public/images) ──
# Compte gratuit sur https://cloudinary.com — les 3 premières valeurs
# viennent de ton Dashboard Cloudinary (Product Environment Credentials).
# Utilisées par scripts/upload-cloudinary.js pour l'upload initial.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# IMPORTANT : cette 4e variable est distincte des 3 précédentes — lib/cloudinary.js
# (cld()) tourne aussi côté navigateur pour construire les URL d'images, et seules
# les variables préfixées NEXT_PUBLIC_ sont exposées au client par Next.js. Sans
# elle, cld() retombe sur une valeur par défaut codée en dur qui peut ne plus
# correspondre à ton compte. Mets ici la MÊME valeur que CLOUDINARY_CLOUD_NAME.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Base de données (dashboard, historique conversations/leads) ──
# Facultatif : le chat fonctionne sans, juste sans historique ni
# dashboard. Neon (https://neon.tech) a un plan gratuit large (0,5 Go).
# Format : postgresql://user:password@host/dbname?sslmode=require
#
# Séparation dev/prod (recommandé, voir Neon Console → Branches) :
#   - IMPORTANT : la CLI Prisma (`prisma db push`, `prisma generate`) ne
#     lit QUE ce fichier .env — jamais .env.local ni .env.development.local
#     (contrairement au serveur Next.js qui lit les deux). Donc la valeur
#     ci-dessous doit être ta branche Neon "development", jamais la prod,
#     sinon un `db push` local risque de modifier le schéma en prod par
#     erreur.
#   - Crée une branche "development" dans Neon Console → Branches, mets
#     SON url ici.
#   - L'url de la branche PROD ne va dans AUCUN fichier local : elle vit
#     uniquement dans Vercel → Project Settings → Environment Variables →
#     DATABASE_URL, scopée sur "Production" (scope "Preview"/"Development"
#     = branche dev, comme ici).
#   - Besoin ponctuel de toucher la prod en local (rare) ? Passe l'url en
#     inline, jamais dans un fichier : PowerShell → $env:DATABASE_URL="...";
#     npx prisma db push
#   - Au démarrage en local, le terminal affiche l'hôte connecté
#     ([DB] Connecté à : ...) pour vérifier en un coup d'œil que c'est
#     bien la branche dev.
DATABASE_URL=

# ── Dashboard admin (/dashboard) — protégé par Basic Auth ──
# Choisis un mot de passe fort, pas "admin"/"password".
ADMIN_USER=
ADMIN_PASSWORD=
