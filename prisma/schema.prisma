// prisma/schema.prisma
// Schéma manquant du zip original — reconstruit à partir de l'usage
// réel dans lib/db.js et les routes API (app/api/leads, /conversations,
// /stats), plus les modèles Visitor/VisitSession/PageView pour le
// tracking de visiteurs (cookies) demandé en plus.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// ASSISTANT IA — conversations, leads, rapports
// ═══════════════════════════════════════════

enum ConversationStatus {
  ACTIVE
  ENDED
  CONVERTED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  CONVERTED
  LOST
}

model Conversation {
  id           String             @id @default(cuid())
  sessionId    String             @unique
  ipHash       String?
  status       ConversationStatus @default(ACTIVE)
  leadScore    Int                @default(0)
  messageCount Int                @default(0)
  createdAt    DateTime           @default(now())
  endedAt      DateTime?

  messages Message[]
  lead     Lead?
  // Une conversation peut donner lieu à un questionnaire de devis
  // (voir section DEVIS AUTOMATISÉS plus bas) — jamais l'inverse : un
  // questionnaire peut aussi être rempli sans passage par le chat.
  questionnaires Questionnaire[]

  @@index([status])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  modelUsed      String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Lead {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String
  contact        String
  projectType    String?
  budgetRange    String?
  timeline       String?
  summary        String
  score          Int          @default(0)
  status         LeadStatus   @default(NEW)
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([status])
  @@index([score])
}

// ═══════════════════════════════════════════
// ANALYTICS — visiteurs, sessions, pages vues
// (posé par le middleware via cookies, jamais par le visiteur lui-même)
// ═══════════════════════════════════════════

model Visitor {
  id         String   @id @default(cuid())
  visitorId  String   @unique // valeur du cookie akatech_visitor
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt
  visitCount Int      @default(1)

  sessions VisitSession[]
}

model VisitSession {
  id             String    @id @default(cuid())
  sessionId      String    @unique // valeur du cookie akatech_session
  visitorId      String
  visitor        Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @updatedAt
  device         String? // mobile | desktop | tablet
  referrer       String?
  userAgent      String?
  consent        String? // 'accepted' | 'rejected' | null = pas encore décidé (bannière cookies)

  pageViews PageView[]
  actions   VisitorAction[]

  @@index([startedAt])
}

model PageView {
  id        String       @id @default(cuid())
  sessionId String
  session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path      String
  viewedAt  DateTime     @default(now())

  @@index([sessionId])
  @@index([viewedAt])
}

// Clics d'action (boutons WhatsApp/téléphone, ouverture du chat IA,
// envoi du formulaire de contact...) — complète PageView, qui ne capture
// que les changements de page. `type` est une valeur whitelistée
// côté serveur (voir ACTION_TYPES dans lib/db.js) : jamais une chaîne
// arbitraire envoyée par le navigateur. `path` est dérivé de l'en-tête
// Referer (chemin seul) — jamais les paramètres d'URL ni le contenu
// d'un champ saisi.
model VisitorAction {
  id        String       @id @default(cuid())
  sessionId String
  session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  path      String?
  createdAt DateTime     @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// FACTURES — dashboard admin (/dashboard, onglet Factures)
// ═══════════════════════════════════════════

enum InvoiceStatus {
  ENVOYEE
  PAYEE
  ANNULEE
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique // ex: F-2026-001
  contractRef   String?
  issueDate     DateTime
  dueDate       DateTime?
  clientName    String
  clientAddress String?
  clientPhone   String?
  clientEmail   String?
  clientRccm    String?
  currency      String        @default("FCFA")
  lines         Json          // [{ desc, qty, price }, ...]
  applyTva      Boolean       @default(true)
  applyTimbre   Boolean       @default(true)
  deposit       Float         @default(0)
  notes         String?
  // Totaux recalculés côté serveur à chaque création/modification
  // (lib/invoice-calc.js) plutôt que de faire confiance à ce que le
  // navigateur envoie — voir lib/db.js.
  subtotal      Float
  tvaAmount     Float
  timbreAmount  Float
  total         Float
  balance       Float
  status        InvoiceStatus @default(ENVOYEE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([issueDate])
}

// ═══════════════════════════════════════════
// DEVIS AUTOMATISÉS — IA du site (dashboard admin, onglet Prospects)
// ═══════════════════════════════════════════
// L'IA du site (lib/assistant.js) oriente un visiteur vers l'un des 3
// questionnaires dynamiques (lib/questionnaires-schema.js) via le tool
// `start_questionnaire`, sans jamais remplir ni calculer le devis
// elle-même dans le chat. Le prospect remplit le formulaire dédié
// (app/devis/[type]), puis lib/quote-calc.js calcule le devis :
// classification par LLM contrainte à un tier existant, prix TOUJOURS
// lu depuis PRICING (lib/data.js) — jamais un montant renvoyé par le
// LLM ou par le navigateur (même principe que lib/invoice-calc.js pour
// les factures).

enum QuestionnaireType {
  PORTFOLIO
  VITRINE_ECOMMERCE
  SAAS
}

enum QuestionnaireStatus {
  STARTED    // lien généré par l'IA, formulaire pas encore ouvert/rempli
  SUBMITTED  // formulaire soumis, devis pas encore calculé (cas rare, calcul synchrone normalement)
  QUOTED     // devis calculé et affiché au prospect + PDF envoyé à Aka
  ACCEPTED   // prospect a cliqué "J'accepte" — formulaire complet reçu par Aka pour conclure
  DECLINED   // prospect a décliné — suivi manuel par Aka (devis PDF envoyé à part)
}

model Questionnaire {
  id             String              @id @default(cuid())
  token          String              @unique // lien public non devinable (crypto.randomUUID())
  type           QuestionnaireType
  conversationId String?
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contactName    String?
  contactHandle  String?             // email ou WhatsApp déjà connu depuis le chat, avant remplissage
  answers        Json?               // réponses brutes — structure = lib/questionnaires-schema.js
  status         QuestionnaireStatus @default(STARTED)
  createdAt      DateTime            @default(now())
  submittedAt    DateTime?
  decidedAt      DateTime?           // date d'acceptation ou de refus

  quote Quote?

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Quote {
  id              String        @id @default(cuid())
  questionnaireId String        @unique
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  category        String        // 'portfolio' | 'vitrine' | 'ecommerce' | 'saas' — clé PRICING (lib/data.js)
  tier            String        // ex: 'STANDARD', 'PRO', 'PLATEFORME_ABONNEMENT'
  priceMinFCFA    Int           // = priceMaxFCFA si prix fixe (portfolio/vitrine/e-commerce/gbp)
  priceMaxFCFA    Int           // fourchette réelle seulement pour les 3 archétypes SaaS
  rationale       String        // justification lisible générée par le LLM — jamais le prix lui-même
  matchedNeeds    Json?         // liste des besoins détectés (affichage devis + email + PDF)
  positioningPitch String?      // texte optionnel "ce qu'AKATech vous apporte" (lib/market-positioning.js)
                                 // — Groq, jamais Gemini : voir ce fichier pour le raisonnement quota.
                                 // null si l'appel a échoué ou a été jugé trop risqué (sanitizePitch) :
                                 // le devis s'affiche normalement sans ce texte dans ce cas.
  createdAt       DateTime      @default(now())

  @@index([category])
}

// ═══════════════════════════════════════════
// BLOG — articles créés depuis le dashboard admin
// ═══════════════════════════════════════════
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   @db.Text
  category    String   @default("Développement Web")
  image       String
  link        String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}
