EXPO_PUBLIC_API_URL=http://localhost:3000

# Mapbox - compte gratuit sur mapbox.com (accepte les cartes prepayees, contrairement a
# Google). Token PUBLIC (commence par pk.), depuis account.mapbox.com/access-tokens -
# le token par defaut cree avec le compte suffit.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.COLLE_TON_TOKEN_ICI

# Mapbox - token SECRET (sk., scope DOWNLOADS:READ), a creer separement sur
# account.mapbox.com/access-tokens (PAS le token par defaut - il faut en creer un nouveau
# avec ce scope coche). Sert uniquement au moment du build natif (jamais bundle dans l'app).
# Utilise seulement en LOCAL si tu fais un prebuild/build natif sur ta machine - pour EAS
# Build (cloud), il faut aussi l'enregistrer via `eas env:create` (voir message du chat).
MAPBOX_DOWNLOADS_TOKEN=sk.COLLE_TON_TOKEN_SECRET_ICI
